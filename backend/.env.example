# ==============================================================================
# POONA POOLS FACILITIES - BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to a new file named .env inside the backend/ directory:
#    cp .env.example .env   (or copy-paste in your editor)
# 2. Fill in your real configuration values.
# 3. NEVER commit the real .env file or your MongoDB password to GitHub!
# ==============================================================================

# Server Port (Render sets this dynamically via $PORT)
PORT=5000

# Environment mode: 'development' or 'production'
# In development: cookies use sameSite='lax', secure=false
# In production: cookies use sameSite='none', secure=true
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <db_username> and <db_password> with your MongoDB Atlas database user credentials.
# Replace the cluster address with your cluster's actual URL.
# 'poona_pools' is the database name where collections will be stored.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@your-cluster.mongodb.net/poona_pools?retryWrites=true&w=majority

# Allowed Frontend URL for CORS
# In local development: http://localhost:5173
# In production: https://your-site-name.vercel.app (can be comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# JWT Secret Key for Admin Authentication (Phase 2)
# Choose a strong random string (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_random_string

# Initial Admin Credentials for One-Time Seeding (Phase 2)
# Used by backend/scripts/seedAdmin.js to create the first admin account safely
ADMIN_EMAIL=admin@poonapools.com
ADMIN_PASSWORD=YourStrongAdminPassword123!
